adjust-cell-height = 25%
adjust-cursor-thickness = 2
cursor-style = bar
font-family = "FiraCode Nerd Font Mono"
font-size = 15
shell-integration = zsh
# window-save-state = always
window-padding-balance = true
window-inherit-working-directory = true
window-padding-x = 10
window-padding-y = 10
window-show-tab-bar = default

# Oscura Midnight — Ghostty Theme
# Based on the Oscura Midnight VS Code theme

background = #0B0B0F
foreground = #E6E6E6

cursor-color = #E6E6E6
selection-background = #5A5B63
selection-foreground = #E6E6E6

# Normal colors
palette = 0=#1A1A1F
palette = 1=#D84F68
palette = 2=#4EBE96
palette = 3=#D2D714
palette = 4=#479FFA
palette = 5=#6E678E
palette = 6=#54C0A3
palette = 7=#C1C1C1

# Bright colors
palette = 8=#5C6974
palette = 9=#FF5C5C
palette = 10=#4EBE96
palette = 11=#E6E7A3
palette = 12=#479FFA
palette = 13=#9099A1
palette = 14=#54C0A3
palette = 15=#E6E6E6